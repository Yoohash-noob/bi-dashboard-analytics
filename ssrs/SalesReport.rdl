<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="SalesDW_DataSource">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost;Initial Catalog=SalesDW;Integrated Security=SSPI</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Windows</rd:SecurityType>
      <rd:DataSourceID>a6df2f8b-f472-4d2c-8068-07d0f7a07ea2</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="SalesSummary">
      <Query>
        <DataSourceName>SalesDW_DataSource</DataSourceName>
        <CommandText>
          SELECT 
              d.CalendarYear AS [Year],
              l.Region AS [Region],
              p.Category AS [Category],
              p.SubCategory AS [SubCategory],
              SUM(f.Quantity) AS [TotalQuantity],
              SUM(f.Revenue) AS [TotalRevenue],
              SUM(f.Profit) AS [TotalProfit],
              (SUM(f.Profit) / NULLIF(SUM(f.Revenue), 0)) * 100 AS [ProfitMargin]
          FROM dbo.FactSales f
          INNER JOIN dbo.DimDate d ON f.DateKey = d.DateKey
          INNER JOIN dbo.DimLocation l ON f.LocationKey = l.LocationKey
          INNER JOIN dbo.DimProduct p ON f.ProductKey = p.ProductKey
          GROUP BY d.CalendarYear, l.Region, p.Category, p.SubCategory
          ORDER BY d.CalendarYear DESC, TotalRevenue DESC
        </CommandText>
      </Query>
      <Fields>
        <Field Name="Year">
          <DataField>Year</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Region">
          <DataField>Region</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Category">
          <DataField>Category</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SubCategory">
          <DataField>SubCategory</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TotalQuantity">
          <DataField>TotalQuantity</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TotalRevenue">
          <DataField>TotalRevenue</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="TotalProfit">
          <DataField>TotalProfit</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="ProfitMargin">
          <DataField>ProfitMargin</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Body>
        <Height>3.5in</Height>
        <Style />
      </Body>
      <Width>7.5in</Width>
      <Page>
        <PageHeader>
          <Height>0.8in</Height>
          <PrintOnFirstPage>true</PrintOnFirstPage>
          <PrintOnLastPage>true</PrintOnLastPage>
          <Style>
            <Border>
              <Style>None</Style>
            </Border>
            <BackgroundColor>#0A0A1A</BackgroundColor>
          </Style>
        </PageHeader>
        <PageHeight>11in</PageHeight>
        <PageWidth>8.5in</PageWidth>
        <LeftMargin>1in</LeftMargin>
        <RightMargin>1in</RightMargin>
        <TopMargin>1in</TopMargin>
        <BottomMargin>1in</BottomMargin>
        <Style />
      </Page>
    </ReportSection>
  </ReportSections>
  <rd:ReportUnit>Inch</rd:ReportUnit>
  <rd:ReportID>8a452ef3-8472-4d2c-8068-12d0f7a07ea2</rd:ReportID>
</Report>
